/************************************************
 * ROFI theme for phosh-overlay-gestures
 * Touch-friendly sizing, positioned to clear the on-screen keyboard
 ***********************************************/

* {
    foreground:                  #ffffff;
    background:                  #242424;
    alternate-normal-background: #2a2a2a;
    selected-normal-background:  #3584e4;
    spacing:                     8;
    separatorcolor:              #383838;
    font:                        "Sans 13";
}
#window {
    background-color: @background;
    border:           0;
    border-radius:    15px;
    padding:          10px;
    margin:           0 4%;
    width:            92%;
    height:           65%;
    location:         north;
    y-offset:         40px;
}
#listview {
    fixed-height: 0;
    border:       2px 0px 0px ;
    border-color: @separatorcolor;
    spacing:      10px ;
    scrollbar:    false;
    padding:      8px 0px 0px ;
}
#element {
    border:        0;
    padding:       12px 10px ;
    border-radius: 10px;
}
#element selected {
    background-color: @selected-normal-background;
}
#element-icon {
    size: 36px;
}
#inputbar {
    spacing:    6px;
    text-color: @foreground;
    padding:    10px ;
    children:   [ textbox-prompt-colon,entry,case-indicator ];
}
#textbox-prompt-colon {
    expand:     false;
    str:        " ";
    margin:     0px 0.4em 0em 0em ;
    text-color: @foreground;
}
